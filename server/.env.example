# Application Config
PORT=5000
NODE_ENV=development

# Database Config
MONGODB_URI=mongodb://127.0.0.1:27017/ats_resume_checker
MONGO_TEST_URI=mongodb://127.0.0.1:27017/ats_resume_checker_test

# Authentication
JWT_SECRET=your_jwt_secret_here

# AI Provider Configuration
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=openai

# Gemini (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (Fallback) - Leave empty if unused
OPENAI_API_KEY=
OPENAI_MODEL=