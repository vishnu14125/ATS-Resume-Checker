# Validated at startup by server/src/config/env.js — the server exits with a clear
# message if a required value is missing or invalid.

# --- Application ---
NODE_ENV=development
PORT=5000
# debug | info | warn | error | silent (default: info; silent under NODE_ENV=test)
LOG_LEVEL=info

# --- Database ---
# Required in production. Defaults to mongodb://127.0.0.1:27017/ats_resume_checker in development.
MONGO_URI=mongodb://127.0.0.1:27017/ats_resume_checker
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# --- Authentication ---
# Required. In production it must be at least 32 characters and must not be this placeholder
# (shorter values only warn in development). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
JWT_EXPIRES_IN=7d

# --- HTTP ---
# Frontend origin allowed by CORS. CORS_ORIGINS (comma-separated) overrides it when set.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://app.example.com,https://staging.example.com
# Number of reverse proxies in front of the server (rate limits use the client IP they report).
# 0 (the default) ignores X-Forwarded-For: use it when clients connect directly. A value higher
# than the real number of proxies lets clients spoof their IP and bypass the rate limits.
# Required in production: set it to the exact hop count of the deployment.
TRUST_PROXY=0
JSON_BODY_LIMIT=10mb
# Fixed limits (not configurable): uploads 10 MB (PDF/DOCX) and 1 MB (TXT), 15 PDF pages,
# 100,000 characters of resume text and 30,000 of job description text.

# --- Rate limits (per client IP, in memory; counts reset when the server restarts) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=900000
ANALYSIS_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# --- AI (optional) ---
# AI only explains and rewords results of the deterministic analysis; the server and the
# analysis work fully without it. AI is enabled only when a provider, its key AND a model
# are all set. Anything missing disables AI with a startup warning; it never stops the server.
# gemini | openai | none
AI_PROVIDER=gemini
# Model id for the selected provider. Required to enable AI; there is no built-in default.
# GEMINI_MODEL / OPENAI_MODEL are used when AI_MODEL is empty.
AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=4096
# Retries for transient provider failures only (0-2).
AI_MAX_RETRIES=1
